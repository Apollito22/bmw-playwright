{
  "name": "bmw-playwright",
  "version": "1.0.0",
  "description": "Automação de testes web da BMW Brasil com Playwright e TypeScript.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium --workers=1",
    "test:headed": "playwright test --project=chromium --headed --workers=1",
    "test:readme": "bash scripts/verificar-readme.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
